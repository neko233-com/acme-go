{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neko233.com/schemas/acme-go/config.schema.json",
  "title": "acme-go configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["account", "certificates"],
  "properties": {
    "ca": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory_url": {
          "type": "string",
          "format": "uri",
          "default": "https://acme-v02.api.letsencrypt.org/directory"
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "accept_tos"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "key_path": { "type": "string", "default": ".acme/account.pem" },
        "accept_tos": { "type": "boolean", "const": true }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "renew_interval": {
          "type": "string",
          "description": "自动续期间隔，供 renew-loop/auto-renew 命令和库入口使用。支持 Go duration，例如 30m、6h、24h；默认按 24h 处理。"
        }
      }
    },
    "dns": { "$ref": "#/$defs/dnsConfig" },
    "dns_providers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dnsConfig" }
    },
    "certificates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certificate" }
    }
  },
  "$defs": {
    "dnsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_ref": {
          "type": "string",
          "description": "引用顶层 dns_providers 里定义的命名 provider，最常见写法是在 certificates[].dns.provider_ref 中复用。"
        },
        "provider": {
          "type": "string",
          "enum": ["alicloud", "aliyun", "alidns", "alicloud-cn", "alicloud-intl", "alicloud-global", "aws", "route53", "aws-global", "azure", "azure-dns", "azure-global", "baiducloud", "baidu", "bce", "baidu-dns", "cloudflare", "cloudflare-intl", "digitalocean", "digital-ocean", "do", "gcloud", "gcp", "google cloud", "google-cloud", "gcloud-global", "hetzner", "hcloud", "hetzner-dns", "huaweicloud", "huawei", "huawei-cloud", "huawei-dns", "huaweicloud-cn", "huaweicloud-intl", "ibmcloud", "ibm", "softlayer", "ibm-dns", "linode", "linode-dns", "oraclecloud", "oracle", "oci", "oracle-dns", "scaleway", "scw", "scaleway-dns", "tencentcloud", "tencent", "dnspod", "tencentcloud-cn", "tencentcloud-intl", "dnspod-intl", "ucloud", "ucloud-dns", "vultr", "vultr-dns", "volcengine", "volc", "volcengine-cn", "volcengine-intl", "volcengine-global"]
        },
        "account_mode": {
          "type": "string",
          "enum": ["cn", "intl", "global", "china", "domestic", "international", "overseas"]
        },
        "region": {
          "type": "string",
          "description": "可选地域覆盖，例如火山引擎可写 cn-beijing、ap-singapore。"
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "access_key": { "type": "string", "description": "通用 access key，适用于阿里云、火山引擎、AWS、华为云等厂商。" },
            "secret_key": { "type": "string", "description": "通用 secret key，适用于阿里云、火山引擎、AWS、华为云等厂商。" },
            "secret_id": { "type": "string", "description": "Tencent-style secret id, also accepted as access key for compatible vendors." },
            "secret_token": { "type": "string", "description": "Optional session token for temporary credentials." },
            "username": { "type": "string", "description": "Username for providers like IBM Cloud SoftLayer." },
            "api_token": { "type": "string", "description": "API token for providers like Cloudflare, DigitalOcean, Hetzner, Linode, and Scaleway." },
            "api_key": { "type": "string", "description": "Fallback API key field for vendors that still use key-based auth, such as Vultr." },
            "api_email": { "type": "string", "description": "Optional API email for Cloudflare legacy auth." },
            "project_id": { "type": "string", "description": "Google Cloud or Scaleway project id." },
            "service_account_file": { "type": "string", "description": "Path to a Google Cloud service account JSON file." },
            "compartment_id": { "type": "string", "description": "Oracle Cloud compartment OCID." },
            "tenancy_id": { "type": "string", "description": "Oracle Cloud tenancy OCID." },
            "user_id": { "type": "string", "description": "Oracle Cloud user OCID." },
            "fingerprint": { "type": "string", "description": "Oracle Cloud API key fingerprint." },
            "private_key_file": { "type": "string", "description": "Path to an Oracle Cloud private key file." },
            "private_key_pass": { "type": "string", "description": "Optional Oracle Cloud private key password." },
            "subscription_id": { "type": "string", "description": "Azure subscription id." },
            "tenant_id": { "type": "string", "description": "Azure tenant id." },
            "client_id": { "type": "string", "description": "Azure client id." },
            "client_secret": { "type": "string", "description": "Azure client secret." },
            "resource_group": { "type": "string", "description": "Azure DNS resource group." }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "disable_cname_support": { "type": "boolean" },
        "disable_complete_propagation": { "type": "boolean" },
        "recursive_nameservers": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "certificateFiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cert_file": { "type": "string", "description": "叶子证书文件名，建议如 cert.pem、tls.crt、server.crt。" },
        "key_file": { "type": "string", "description": "私钥文件名，建议如 privkey.pem、tls.key、server.key。" },
        "public_key_file": { "type": "string", "description": "公钥文件名，建议如 pubkey.pem、server.pub。" },
        "fullchain_file": { "type": "string", "description": "fullchain 文件名，建议如 fullchain.pem、fullchain.crt、server.crt。" },
        "chain_file": { "type": "string", "description": "签发链文件名，建议如 issuer.pem、chain.pem、ca.crt。" },
        "metadata_file": { "type": "string", "description": "续期元数据文件名，建议如 metadata.json、acme.json。" }
      }
    },
    "installConfig": {
      "$ref": "#/$defs/certificateFiles"
    },
    "deployTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["", "copy", "command"] },
        "directory": { "type": "string" },
        "command": { "type": "string" },
        "cert_file": { "type": "string" },
        "key_file": { "type": "string" },
        "public_key_file": { "type": "string" },
        "fullchain_file": { "type": "string" },
        "chain_file": { "type": "string" },
        "metadata_file": { "type": "string" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre_issue": { "$ref": "#/$defs/commands" },
        "post_issue": { "$ref": "#/$defs/commands" },
        "pre_renew": { "$ref": "#/$defs/commands" },
        "post_renew": { "$ref": "#/$defs/commands" },
        "post_revoke": { "$ref": "#/$defs/commands" },
        "post_install": { "$ref": "#/$defs/commands" },
        "post_deploy": { "$ref": "#/$defs/commands" }
      }
    },
    "commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains"],
      "properties": {
        "name": { "type": "string" },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "dns": { "$ref": "#/$defs/dnsConfig" },
        "output_dir": { "type": "string" },
        "output_files": { "$ref": "#/$defs/certificateFiles" },
        "key_type": { "type": "string", "enum": ["ec256", "ec384", "rsa2048", "rsa4096", "rsa8192"] },
        "bundle": { "type": "boolean" },
        "must_staple": { "type": "boolean" },
        "preferred_chain": { "type": "string" },
        "csr_path": { "type": "string" },
        "webroot_path": { "type": "string" },
        "http_bind": { "type": "string" },
        "http_port": { "type": "string" },
        "tlsalpn_bind": { "type": "string" },
        "tlsalpn_port": { "type": "string" },
        "renew_before_days": { "type": "integer", "minimum": 1 },
        "challenge": { "type": "string", "enum": ["dns-01", "http-01", "webroot", "standalone", "tls-alpn-01"] },
        "install": { "$ref": "#/$defs/installConfig" },
        "deploy": {
          "type": "array",
          "items": { "$ref": "#/$defs/deployTarget" }
        },
        "hooks": { "$ref": "#/$defs/hooks" }
      }
    }
  }
}
