{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "validate: tests",
      "type": "shell",
      "command": "go test ./...",
      "group": "test",
      "problemMatcher": "$go"
    },
    {
      "label": "validate: diff check",
      "type": "shell",
      "command": "git diff --check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "validate: config example",
      "type": "shell",
      "command": "go run . validate -config config_acme.json",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "validate: config test",
      "type": "shell",
      "command": "go run . validate -config config_acme.test.json",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "validate: github actions",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/validate-github-actions.ps1",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
