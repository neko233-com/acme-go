[
  {
    "name": "defaults-and-env",
    "env": {
      "ACME_EMAIL": "ops@example.com"
    },
    "base_config": "account:\n  email: ${ACME_EMAIL}\n  accept_tos: true\ndns:\n  provider: cloudflare\ncertificates:\n  - name: example\n    domains:\n      - example.com\n",
    "local_override": "",
    "expect": {
      "email": "ops@example.com",
      "provider": "cloudflare",
      "first_domain": "example.com",
      "renew_before_days": 30,
      "challenge": "dns-01",
      "bundle": true
    }
  },
  {
    "name": "local-json-override",
    "env": {
      "ACME_EMAIL": "ops@example.com"
    },
    "base_config": "account:\n  email: ${ACME_EMAIL}\n  accept_tos: true\ndns:\n  provider: cloudflare\ncertificates:\n  - name: example\n    domains:\n      - example.com\n",
    "local_override": "{\n  \"dns\": {\n    \"provider\": \"alidns\",\n    \"env\": {\n      \"ALICLOUD_ACCESS_KEY\": \"override-key\"\n    }\n  },\n  \"certificates\": [\n    {\n      \"name\": \"example\",\n      \"domains\": [\"test.neko233.com\", \"*.test.neko233.com\"]\n    }\n  ]\n}",
    "expect": {
      "email": "ops@example.com",
      "provider": "alidns",
      "first_domain": "test.neko233.com",
      "renew_before_days": 30,
      "challenge": "dns-01",
      "bundle": true,
      "env": {
        "ALICLOUD_ACCESS_KEY": "override-key"
      }
    }
  }
]